{{> layout_top }}

{{> hero }}

<!-- SERVICES OVERVIEW -->
<section class="section" id="services">
  <div class="container">
    <div style="text-align:center;margin-bottom:50px">
      <span class="section-tag reveal">What We Do</span>
      <h2 class="section-title reveal stagger-1">Comprehensive <span class="gradient-text">Solutions</span></h2>
      <p style="color:var(--gray);max-width:600px;margin:16px auto 0;line-height:1.7" class="reveal stagger-2">Professional services tailored to your property's needs. We use top-tier equipment and eco-friendly solutions.</p>
    </div>
    <div class="grid-2">
      <!-- We can loop over services array if we augment config to include descriptions, but for now we hardcode the grid layout with base vars -->
      {{#each services}}
      <article class="service-card reveal stagger-1">
        <a href="{{url}}" style="text-decoration:none;color:inherit;display:block">
          <div style="font-size:48px;margin-bottom:20px;filter:drop-shadow(0 0 10px rgba(255,69,0,0.3))">{{icon}}</div>
          <h3 class="service-card-title">{{name}}</h3>
          <p class="service-card-desc">Professional {{name}} services to increase curb appeal and property value.</p>
          <div class="service-card-link">Learn More <span class="arrow">→</span></div>
        </a>
      </article>
      {{/each}}
    </div>
  </div>
</section>

<!-- WHY CHOOSE US -->
<section class="section" style="background:#1A1A1A;position:relative;overflow:hidden">
  <div class="container relative">
    <div class="grid-2" style="align-items:center;gap:60px">
      <div class="reveal-left">
        <span class="section-tag">The {{business.short_name}} Difference</span>
        <h2 class="section-title">Why Glasgow <br>Chooses <span class="gradient-text">Us</span></h2>
        <p style="color:var(--light);font-size:16px;line-height:1.8;margin:24px 0 32px">{{business.long_description}}</p>
        <ul style="list-style:none;padding:0;display:flex;flex-direction:column;gap:16px">
          <li style="display:flex;align-items:center;gap:12px;color:var(--light);font-size:16px">
            <div style="width:24px;height:24px;border-radius:50%;background:rgba(255,69,0,0.2);color:var(--red);display:flex;align-items:center;justify-content:center;font-size:12px">✓</div>
            100% Satisfaction Guarantee
          </li>
          <li style="display:flex;align-items:center;gap:12px;color:var(--light);font-size:16px">
            <div style="width:24px;height:24px;border-radius:50%;background:rgba(255,69,0,0.2);color:var(--red);display:flex;align-items:center;justify-content:center;font-size:12px">✓</div>
            Licensed &amp; Fully Insured
          </li>
          <li style="display:flex;align-items:center;gap:12px;color:var(--light);font-size:16px">
            <div style="width:24px;height:24px;border-radius:50%;background:rgba(255,69,0,0.2);color:var(--red);display:flex;align-items:center;justify-content:center;font-size:12px">✓</div>
            Eco-Friendly Cleaning Solutions
          </li>
        </ul>
      </div>
      <div class="reveal-right" style="position:relative">
         <div style="width:100%;height:400px;background:linear-gradient(135deg, #1E2139, #0F0F0F);border-radius:24px;border: 1px solid rgba(255,255,255,0.05);display:flex;align-items:center;justify-content:center;flex-direction:column;gap:16px;">
            <div style="font-size:64px;">🏆</div>
            <h3 style="color:white;font-size:24px;font-weight:700">Top Rated Service</h3>
         </div>
      </div>
    </div>
  </div>
</section>

