<div style="background:linear-gradient(135deg, {{theme.primary_color}}, {{theme.secondary_color}});padding:80px 40px;text-align:center">
  <h2 style="font-family:'Sora',sans-serif;font-size:clamp(24px,3vw,40px);color:white;margin-bottom:12px;font-weight:800">Ready to Get Started?</h2>
  <p style="color:rgba(255,255,255,.9);font-size:16px;margin-bottom:28px">Join {{stats.stat3_num}} homeowners who trust {{business.name}}.</p>
  <div style="display:flex;gap:14px;justify-content:center;flex-wrap:wrap">
    <a href="tel:{{contact.phone_raw}}" style="background:#0F0F0F;color:var(--red);border:2px solid var(--red);padding:16px 36px;border-radius:14px;font-size:14px;font-weight:800;letter-spacing:1px;text-transform:uppercase;display:inline-flex;align-items:center;transition:all .3s" onmouseover="this.style.background='var(--red)';this.style.color='white'" onmouseout="this.style.background='#0F0F0F';this.style.color='var(--red)'">{{cta.primary_btn}}</a>
    <a href="contact.html" style="background:rgba(255,255,255,.15);color:white;border:2px solid rgba(255,255,255,.4);padding:16px 36px;border-radius:14px;font-size:14px;font-weight:700;letter-spacing:1px;text-transform:uppercase;display:inline-flex;align-items:center">{{cta.secondary_btn}}</a>
  </div>
</div>
