<!-- HERO SECTION -->
<div class="hero">
  <div class="hero-bg-accent" aria-hidden="true"></div>
  <div class="container"><div class="hero-content">
    <div class="hero-badge reveal" style="margin-bottom:16px;">{{hero.badge}}</div>
    <h1 class="hero-title reveal stagger-1">{{hero.heading_part1}} <span class="gradient-text">{{hero.heading_gradient}}</span></h1>
    <p class="hero-sub reveal stagger-2">{{hero.subtext}}</p>
    <div class="hero-cta reveal stagger-3">
      <a href="tel:{{contact.phone_raw}}" class="btn btn-primary btn-lg shine">📞 {{contact.phone}}</a>
      <a href="contact.html" class="btn btn-secondary btn-lg play-btn">📋 Get A Fast Quote</a>
    </div>
  </div></div>
  <div class="hero-stats">
    <div class="hero-stat reveal stagger-2"><strong>{{stats.stat1_num}}</strong><span>{{stats.stat1_label}}</span></div>
    <div class="hero-stat-div"></div>
    <div class="hero-stat reveal stagger-3"><strong>{{stats.stat2_num}}</strong><span>{{stats.stat2_label}}</span></div>
    <div class="hero-stat-div"></div>
    <div class="hero-stat reveal stagger-4"><strong>{{stats.stat3_num}}</strong><span>{{stats.stat3_label}}</span></div>
  </div>
</div>
